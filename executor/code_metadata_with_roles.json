        }
      ],
      "tb:hasParameters": [
        {
          "tb:name": "data",
          "tb:role": "previousResult",
          "tb:type": "DicomDataset",
          "tb:description": "DICOM dataset to anonymize"
        },
        {
          "tb:name": "attr",
          "tb:role": "attributeReference",
          "tb:type": "string",
          "tb:description": "DICOM tag to anonymize"
        }
      ],
      "tb:hasCode": [
        {
          "tb:code": "data.data_element(attr).value = 'ANONYMOUS'"
        }
