    {
      "@id": "ab:ImpCheckFreshness",
      "@type": "tb:Implementation",
      "tb:forOp": [
        {
          "@id": "ab:CheckFreshness"
        }
      ],
      "tb:forType": [
        {
          "@id": "ab:Tabular"
        }
      ],
      "tb:hasParameters": [
        {
          "tb:name": "data",
          "tb:role": "previousResult",
          "tb:type": "DataFrame",
          "tb:description": "Data from previous operation"
        },
        {
          "tb:name": "ts_attr",
          "tb:role": "attributeReference",
          "tb:type": "string",
          "tb:description": "Name of timestamp column"
        }
      ],
      "tb:hasCode": [
        {
          "tb:code": "data[data[ts_attr].apply(lambda x: (datetime.now() - pd.to_datetime(x)).total_seconds() / 60 < 30)]"
        }
      ],
      "tb:dependsOn": [
        {
          "tb:name": "pandas"
        },
        {
          "tb:name": "datetime"
        }
      ]
