          "tb:name": "data",
          "tb:role": "previousResult",
          "tb:type": "DataFrame",
          "tb:description": "Data to validate"
        },
        {
          "tb:name": "attr",
          "tb:role": "targetAttribute",
          "tb:type": "string",
          "tb:description": "Column to check for validity"
        },
        {
          "tb:name": "allowed",
          "tb:role": "allowedValues",
          "tb:type": "list",
          "tb:description": "List of allowed values"
        }
      ],
      "tb:hasCode": [
        {
          "tb:code": "data[attr].isin(allowed).all()"
        }
