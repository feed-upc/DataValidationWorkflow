      ],
      "tb:forType": [
        {
          "@id": "ab:Tabular"
        }
      ],
      "tb:hasParameters": [
        {
          "tb:name": "data",
          "tb:role": "previousResult",
          "tb:type": "DataFrame",
          "tb:description": "Data to assess"
        },
        {
          "tb:name": "attr",
          "tb:role": "attributeReference",
          "tb:type": "string",
          "tb:description": "Column to check for completeness"
        }
      ],
      "tb:hasCode": [
        {
          "tb:code": "(1 - data[attr].isna().sum() / len(data)) * 100"
        }
      ],
      "tb:dependsOn": [
        {
          "tb:name": "pandas"
        }
      ]
    },
