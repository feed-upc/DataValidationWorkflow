          "tb:type": "string",
          "tb:description": "Column to check for validity"
        },
        {
          "tb:name": "vocab",
          "tb:role": "vocabularyRef",
          "tb:type": "string",
          "tb:description": "Vocabulary reference"
        }
      ],
      "tb:hasCode": [
