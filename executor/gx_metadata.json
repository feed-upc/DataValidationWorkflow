            "tb:gxExpectationType": "expect_column_values_to_be_in_set",
            "tb:gxClass": "ExpectColumnValuesToBeInSet",
            "tb:gxParams": [
                {"tb:gxParam": "column", "tb:gxSource": "binding", "tb:gxKey": "attr"}
            ],
            "tb:gxConstraintMode": "value_set",
            "tb:gxNeedsDataframe": false,
            "tb:gxSetupCode": "import pycountry\n    _kw['value_set'] = [c.alpha_2 for c in pycountry.countries]",
            "tb:gxExtraImports": ["pycountry"],
            "tb:dependsOn": [
                {
                    "tb:name": "great_expectations"
                },
                {
                    "tb:name": "pycountry"
                }
            ]
        },
        {
            "@id": "ab:ImpQualityMetricFairness",
            "@type": "tb:Implementation",
            "rdfs:comment": "DQRP6 (DQR5EH): Fairness check - class imbalance via KL divergence",
            "tb:forOp": [
                {
                    "@id": "ab:CheckFairness"
                }
            ],
            "tb:forType": [
                {
                    "@id": "ab:Tabular"
                }
            ],
            "tb:gxExpectationType": "expect_column_kl_divergence_to_be_less_than",
            "tb:gxClass": "ExpectColumnKLDivergenceToBeLessThan",
            "tb:gxParams": [
                {"tb:gxParam": "column", "tb:gxSource": "binding", "tb:gxKey": "attr"}
            ],
            "tb:gxConstraintMode": "threshold_scaled",
            "tb:gxNeedsDataframe": true,
            "tb:gxSetupCode": "_cats = sorted(_df['{column}'].dropna().unique().tolist())\n    _uniform = {{\"values\": _cats, \"weights\": [1.0/len(_cats)]*len(_cats)}}\n    _kw['partition_object'] = _uniform",
            "tb:dependsOn": [
                {
                    "tb:name": "great_expectations"
                }
            ]
        },
        {
            "@id": "ab:ImpQualityMetricConsistency",
            "@type": "tb:Implementation",
            "rdfs:comment": "DQRP4: Consistency check - conditional column null validation",
            "tb:forOp": [
                {
                    "@id": "ab:CheckConsistency"
                }
            ],
            "tb:forType": [
                {
                    "@id": "ab:Tabular"
                }
