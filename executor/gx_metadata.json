            "tb:dependsOn": [
                {
                    "tb:name": "great_expectations"
                }
            ]
        },
        {
            "@id": "ab:ImpQualityMetric",
            "@type": "tb:Implementation",
            "rdfs:comment": "DQRP2 (DQR1EH): Completeness check",
            "tb:forOp": [
