            "tb:gxParams": [
                {"tb:gxParam": "column", "tb:gxSource": "computed", "tb:gxValue": "{ts_attr}_age_minutes"}
            ],
            "tb:gxConstraintMode": "range_0_max",
            "tb:gxNeedsDataframe": true,
            "tb:gxSetupCode": "_df['{ts_attr}_age_minutes'] = (pd.Timestamp.now() - pd.to_datetime(_df['{ts_attr}'])).dt.total_seconds() / 60.0",
            "tb:dependsOn": [
                {
                    "tb:name": "great_expectations"
                },
