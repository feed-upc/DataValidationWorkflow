            "tb:gxParams": [
                {"tb:gxParam": "column", "tb:gxSource": "binding", "tb:gxKey": "attr"}
            ],
            "tb:gxConstraintMode": "mostly",
            "tb:gxNeedsDataframe": false,
            "tb:dependsOn": [
                {
                    "tb:name": "great_expectations"
                }
            ]
        },
        {
            "@id": "ab:ImpQualityMetricValidity",
            "@type": "tb:Implementation",
            "rdfs:comment": "DQRP3: Validity check - percentage of values adhering to ISO 3166 alpha-2",
            "tb:forOp": [
                {
                    "@id": "ab:CheckValidity"
                }
            ],
            "tb:forType": [
                {
                    "@id": "ab:Tabular"
                }
