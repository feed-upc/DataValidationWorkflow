            "tb:gxParams": [
                {"tb:gxParam": "column", "tb:gxSource": "binding", "tb:gxKey": "attr"}
            ],
            "tb:gxConstraintMode": "row_condition",
            "tb:gxNeedsDataframe": false,
            "tb:dependsOn": [
