{
  "@context": {
    "tb": "http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/tbox#",
    "ab": "http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/abox#",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@graph": [
    {
      "@id": "ab:Imp1",
      "@type": "tb:Implementation",
      "tb:forOp": [
        {
          "@id": "ab:LoadData"
        }
      ],
      "tb:forType": [
        {
          "@id": "ab:Tabular"
        }
      ],
      "tb:hasParameters": [
        {
          "tb:name": "p",
          "tb:role": "filePath",
          "tb:type": "string",
          "tb:description": "Path to CSV file"
        }
      ],
      "tb:hasCode": [
        {
          "tb:code": "pandas.read_csv(p)"
        }
      ],
      "tb:dependsOn": [
        {
          "tb:name": "pandas"
        }
      ]
    },
    {
      "@id": "ab:ImpCheckFreshness",
      "@type": "tb:Implementation",
      "tb:forOp": [
        {
          "@id": "ab:CheckFreshness"
        }
      ],
      "tb:forType": [
        {
          "@id": "ab:Tabular"
        }
      ],
      "tb:hasParameters": [
        {
          "tb:name": "data",
          "tb:role": "previousResult",
          "tb:type": "DataFrame",
          "tb:description": "Data from previous operation"
        },
        {
          "tb:name": "ts_attr",
          "tb:role": "attributeReference",
          "tb:type": "string",
          "tb:description": "Name of timestamp column"
        }
      ],
      "tb:hasCode": [
        {
          "tb:code": "(datetime.now() - pd.to_datetime(data[ts_attr], utc=True).dt.tz_convert(None)).dt.total_seconds() / 60"
        }
      ],
      "tb:dependsOn": [
        {
          "tb:name": "pandas"
        },
        {
          "tb:name": "datetime"
        }
      ]
    },
    {
      "@id": "ab:ImpConstraintLteq",
      "@type": "tb:Implementation",
      "tb:forOp": [
        {
          "@id": "odrl:Constraint"
        }
      ],
      "tb:forOperator": "odrl:lteq",
      "tb:forType": [
        {
          "@id": "ab:Tabular"
        }
      ],
      "tb:hasParameters": [
        {
          "tb:name": "data",
          "tb:role": "previousResult",
          "tb:type": "DataFrame",
          "tb:description": "Data from previous operation"
        },
        {
          "tb:name": "threshold",
          "tb:role": "threshold",
          "tb:type": "number",
          "tb:description": "Maximum allowed value"
        },
        {
          "tb:name": "operator",
          "tb:role": "operator",
          "tb:type": "string",
          "tb:description": "ODRL operator URI"
        }
      ],
      "tb:hasCode": [
        {
          "tb:code": "data <= threshold"
        }
      ],
      "tb:dependsOn": []
    },
    {
      "@id": "ab:ImpConstraintGteq",
      "@type": "tb:Implementation",
      "tb:forOp": [
        {
          "@id": "odrl:Constraint"
        }
      ],
      "tb:forOperator": "odrl:gteq",
      "tb:forType": [
        {
          "@id": "ab:Tabular"
        }
      ],
      "tb:hasParameters": [
        {
          "tb:name": "data",
          "tb:role": "previousResult",
          "tb:type": "DataFrame",
          "tb:description": "Data from previous operation"
        },
        {
          "tb:name": "threshold",
          "tb:role": "threshold",
          "tb:type": "number",
          "tb:description": "Minimum allowed value"
        },
        {
          "tb:name": "operator",
          "tb:role": "operator",
          "tb:type": "string",
          "tb:description": "ODRL operator URI"
        }
      ],
      "tb:hasCode": [
        {
          "tb:code": "data >= threshold"
        }
      ],
      "tb:dependsOn": []
    },
    {
      "@id": "ab:ImpQualityMetric",
      "@type": "tb:Implementation",
      "rdfs:comment": "DQRP2 (DQR1EH): Completeness check - calculates percentage of non-null values for an attribute",
      "tb:forOp": [
        {
          "@id": "ab:qM"
        }
      ],
      "tb:forType": [
        {
          "@id": "ab:Tabular"
        }
      ],
      "tb:hasParameters": [
        {
          "tb:name": "data",
          "tb:role": "previousResult",
          "tb:type": "DataFrame",
          "tb:description": "Data to assess"
        },
        {
          "tb:name": "attr",
          "tb:role": "attributeReference",
          "tb:type": "string",
          "tb:description": "Column to check for completeness (e.g., patientID)"
        }
      ],
      "tb:hasCode": [
        {
          "tb:code": "(1 - data[attr].isna().sum() / len(data)) * 100"
        }
      ],
      "tb:dependsOn": [
        {
          "tb:name": "pandas"
        }
      ]
    }
  ]
}