{
  "@context": {
    "tb": "http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/tbox#",
    "ab": "http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/abox#",
    "odrl": "http://www.w3.org/ns/odrl/2/"
  },
  "@graph": [
    {
      "@id": "ab:Imp1",
      "@type": "tb:Implementation",
      "tb:forOp": [
        {
          "@id": "ab:LoadData"
        }
      ],
      "tb:forType": [
        {
          "@id": "ab:Tabular"
        }
      ],
      "tb:hasParameters": [
        {
          "tb:name": "p",
          "tb:role": "filePath",
          "tb:type": "string",
          "tb:description": "Path to CSV file"
        }
      ],
      "tb:hasCode": [
        {
          "tb:code": "pandas.read_csv(p)"
        }
      ],
      "tb:dependsOn": [
        {
          "tb:name": "pandas"
        }
      ]
    },
    {
      "@id": "ab:ImpCheckFreshness",
      "@type": "tb:Implementation",
      "tb:forOp": [
        {
          "@id": "ab:CheckFreshness"
        }
      ],
      "tb:forType": [
        {
          "@id": "ab:Tabular"
        }
      ],
      "tb:hasParameters": [
        {
          "tb:name": "data",
          "tb:role": "previousResult",
          "tb:type": "DataFrame",
          "tb:description": "Data from previous operation"
        },
        {
          "tb:name": "ts_attr",
          "tb:role": "attributeReference",
          "tb:type": "string",
          "tb:description": "Name of timestamp column"
        }
      ],
      "tb:hasCode": [
        {
          "tb:code": "(datetime.now() - pd.to_datetime(data[ts_attr], utc=True).dt.tz_convert(None)).dt.total_seconds() / 60"
        }
      ],
      "tb:dependsOn": [
        {
          "tb:name": "pandas"
        },
        {
          "tb:name": "datetime"
        }
      ]
    },
    {
      "@id": "ab:ImpConstraintLteq",
      "@type": "tb:Implementation",
      "tb:forOp": [
        {
          "@id": "odrl:Constraint"
        }
      ],
      "tb:forOperator": "odrl:lteq",
      "tb:forType": [
        {
          "@id": "ab:Tabular"
        }
      ],
      "tb:hasParameters": [
        {
          "tb:name": "data",
          "tb:role": "previousResult",
          "tb:type": "DataFrame",
          "tb:description": "Data from previous operation"
        },
        {
          "tb:name": "threshold",
          "tb:role": "threshold",
          "tb:type": "number",
          "tb:description": "Maximum allowed value"
        },
        {
          "tb:name": "operator",
          "tb:role": "operator",
          "tb:type": "string",
          "tb:description": "ODRL operator URI"
        }
      ],
      "tb:hasCode": [
        {
          "tb:code": "data <= threshold"
        }
      ],
      "tb:dependsOn": []
    },
    {
      "@id": "ab:ImpConstraintGteq",
      "@type": "tb:Implementation",
      "tb:forOp": [
        {
          "@id": "odrl:Constraint"
        }
      ],
      "tb:forOperator": "odrl:gteq",
      "tb:forType": [
        {
          "@id": "ab:Tabular"
        }
      ],
      "tb:hasParameters": [
        {
          "tb:name": "data",
          "tb:role": "previousResult",
          "tb:type": "DataFrame",
          "tb:description": "Data from previous operation"
        },
        {
          "tb:name": "threshold",
          "tb:role": "threshold",
          "tb:type": "number",
          "tb:description": "Minimum allowed value"
        },
        {
          "tb:name": "operator",
          "tb:role": "operator",
          "tb:type": "string",
          "tb:description": "ODRL operator URI"
        }
      ],
      "tb:hasCode": [
        {
          "tb:code": "data >= threshold"
        }
      ],
      "tb:dependsOn": []
    },
    {
      "@id": "ab:ImpConstraintEq",
      "@type": "tb:Implementation",
      "tb:forOp": [
        {
          "@id": "odrl:Constraint"
        }
      ],
      "tb:forOperator": "odrl:eq",
      "tb:forType": [
        {
          "@id": "ab:Tabular"
        }
      ],
      "tb:hasParameters": [
        {
          "tb:name": "data",
          "tb:role": "previousResult",
          "tb:type": "DataFrame",
          "tb:description": "Data from previous operation"
        },
        {
          "tb:name": "threshold",
          "tb:role": "threshold",
          "tb:type": "number",
          "tb:description": "Required value"
        },
        {
          "tb:name": "operator",
          "tb:role": "operator",
          "tb:type": "string",
          "tb:description": "ODRL operator URI"
        }
      ],
      "tb:hasCode": [
        {
          "tb:code": "data == threshold"
        }
      ],
      "tb:dependsOn": []
    },
    {
      "@id": "ab:ImpConstraintIsIncludedIn",
      "@type": "tb:Implementation",
      "tb:forOp": [
        {
          "@id": "odrl:Constraint"
        }
      ],
      "tb:forOperator": "odrl:isIncludedIn",
      "tb:forType": [
        {
          "@id": "ab:Tabular"
        }
      ],
      "tb:hasParameters": [
        {
          "tb:name": "data",
          "tb:role": "previousResult",
          "tb:type": "DataFrame",
          "tb:description": "Data from previous quality metric (percentage or boolean)"
        },
        {
          "tb:name": "threshold",
          "tb:role": "threshold",
          "tb:type": "string",
          "tb:description": "Reference standard identifier (e.g. ISO_3166)"
        },
        {
          "tb:name": "operator",
          "tb:role": "operator",
          "tb:type": "string",
          "tb:description": "ODRL operator URI"
        }
      ],
      "tb:hasCode": [
        {
          "tb:code": "data == 100"
        }
      ],
      "tb:dependsOn": []
    },
    {
      "@id": "ab:ImpQualityMetric",
      "@type": "tb:Implementation",
      "rdfs:comment": "DQRP2 (DQR1EH): Completeness check - calculates percentage of non-null values for an attribute",
      "tb:forOp": [
        {
          "@id": "ab:CheckCompleteness"
        }
      ],
      "tb:forType": [
        {
          "@id": "ab:Tabular"
        }
      ],
      "tb:hasParameters": [
        {
          "tb:name": "data",
          "tb:role": "previousResult",
          "tb:type": "DataFrame",
          "tb:description": "Data to assess"
        },
        {
          "tb:name": "attr",
          "tb:role": "attributeReference",
          "tb:type": "string",
          "tb:description": "Column to check for completeness (e.g., patientID)"
        }
      ],
      "tb:hasCode": [
        {
          "tb:code": "(1 - data[attr].isna().sum() / len(data)) * 100"
        }
      ],
      "tb:dependsOn": [
        {
          "tb:name": "pandas"
        }
      ]
    },
    {
      "@id": "ab:ImpQualityMetricValidity",
      "@type": "tb:Implementation",
      "rdfs:comment": "DQRP3: Validity check - percentage of values adhering to ISO 3166 alpha-2",
      "tb:forOp": [
        {
          "@id": "ab:CheckValidity"
        }
      ],
      "tb:forType": [
        {
          "@id": "ab:Tabular"
        }
      ],
      "tb:hasParameters": [
        {
          "tb:name": "data",
          "tb:role": "previousResult",
          "tb:type": "DataFrame",
          "tb:description": "Data to assess"
        },
        {
          "tb:name": "attr",
          "tb:role": "attributeReference",
          "tb:type": "string",
          "tb:description": "Column to check for validity (e.g., countryOfAffiliation)"
        }
      ],
      "tb:hasCode": [
        {
          "tb:code": "(data[attr].astype(str).str.upper().isin({country.alpha_2 for country in __import__('pycountry').countries})).sum() / len(data) * 100"
        }
      ],
      "tb:dependsOn": [
        {
          "tb:name": "pandas"
        },
        {
          "tb:name": "pycountry"
        }
      ]
    },
    {
      "@id": "ab:ImpQualityMetricFairness",
      "@type": "tb:Implementation",
      "rdfs:comment": "DQRP6 (DQR5EH): Fairness check - calculates max percentage of any discrete group",
      "tb:forOp": [
        {
          "@id": "ab:CheckFairness"
        }
      ],
      "tb:forType": [
        {
          "@id": "ab:Tabular"
        }
      ],
      "tb:hasParameters": [
        {
          "tb:name": "data",
          "tb:role": "previousResult",
          "tb:type": "DataFrame",
          "tb:description": "Data to assess"
        },
        {
          "tb:name": "attr",
          "tb:role": "attributeReference",
          "tb:type": "string",
          "tb:description": "Column to check for fairness (e.g., gender)"
        }
      ],
      "tb:hasCode": [
        {
          "tb:code": "data[attr].value_counts(normalize=True).max() * 100"
        }
      ],
      "tb:dependsOn": [
        {
          "tb:name": "pandas"
        }
      ]
    },
    {
      "@id": "ab:ImpQualityMetricRowCount",
      "@type": "tb:Implementation",
      "rdfs:comment": "DQRP5: Volume check - counts the number of rows in the dataset",
      "tb:forOp": [
        {
          "@id": "ab:CheckVolume"
        }
      ],
      "tb:forType": [
        {
          "@id": "ab:Tabular"
        }
      ],
      "tb:hasParameters": [
        {
          "tb:name": "data",
          "tb:role": "previousResult",
          "tb:type": "DataFrame",
          "tb:description": "Data to assess"
        }
      ],
      "tb:hasCode": [
        {
          "tb:code": "len(data)"
        }
      ],
      "tb:dependsOn": [
        {
          "tb:name": "pandas"
        }
      ]
    },
    {
      "@id": "ab:ImpQualityMetricConsistency",
      "@type": "tb:Implementation",
      "rdfs:comment": "DQRP4: Consistency check - if gender is M, pregnancyHistory must be NULL",
      "tb:forOp": [
        {
          "@id": "ab:CheckConsistency"
        }
      ],
      "tb:forType": [
        {
          "@id": "ab:Tabular"
        }
      ],
      "tb:hasParameters": [
        {
          "tb:name": "data",
          "tb:role": "previousResult",
          "tb:type": "DataFrame",
          "tb:description": "Data to assess"
        },
        {
          "tb:name": "attr",
          "tb:role": "attributeReference",
          "tb:type": "string",
          "tb:description": "Column to check for consistency (e.g., pregnancyHistory)"
        }
      ],
      "tb:hasCode": [
        {
          "tb:code": "(data.loc[data['gender'].isin(['M', 'male']), attr].isna().sum() / max(data['gender'].isin(['M', 'male']).sum(), 1)) * 100"
        }
      ],
      "tb:dependsOn": [
        {
          "tb:name": "pandas"
        }
      ]
    }
  ]
}