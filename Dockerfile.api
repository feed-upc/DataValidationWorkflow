FROM python:3.12-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    nodejs \
    npm \
    git \
    curl \
    docker.io \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Node requirements
COPY package.json ./
RUN npm install

# Install Python requirements
COPY requirements.txt .
COPY api_requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt -r api_requirements.txt

# Copy node_modules to a known location accessible at runtime
RUN cp -r /app/node_modules /opt/node_modules

# The project is volume-mounted at /project at runtime.
# We set /project as the working directory so the API always uses
# the latest code and metadata from the host.
ENV PYTHONPATH=/project/Connector/ValidationFramework:/project
ENV PATH="/opt/node_modules/.bin:/app/node_modules/.bin:${PATH}"
ENV PROJECT_ROOT=/project

# Expose FastAPI port
EXPOSE 5000

WORKDIR /project

# Run the API from the volume-mounted project
CMD ["python", "Connector/ValidationFramework/api/api.py"]
