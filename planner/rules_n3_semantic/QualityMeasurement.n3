# N3 Logic Rule: Quality Measurement Policy Transformation (SEMANTIC VERSION)
# Rule Chaining - Automatically chains from LoadData operation
#
# Transforms DQV Quality policies into data quality validation operations.
# USES SEMANTIC PROPERTIES instead of flat hasInput for unambiguous parameter binding.

@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix tb: <http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/tbox#> .
@prefix ab: <http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/abox#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

# Rule 1: Quality Policy with Constraint → Validation Operation
# Chains from LoadData when Quality policy with constraint exists
# Uses SEMANTIC properties for clarity and extensibility
{
    # Match PolicyChecker with Quality policy
    ?pc a tb:PolicyChecker ;
        tb:accordingTo ?policy ;
        tb:nextStep ?loadOp .
    
    # LoadData operation
    ?loadOp a tb:Operation ;
            tb:hasAbstract ab:LoadData .
    
    # Quality policy structure
    ?policy a dqv:QualityPolicy ;
            odrl:duty ?duty .
    
    ?duty odrl:target ?semanticTarget ;
          odrl:constraint ?constraint .
    
    # Get physical attribute resolved by ConstraintPropagation rule
    ?duty tb:physicalAttribute ?physicalAttr .
    
    # Constraint details
    ?constraint odrl:leftOperand ?metric ;
                odrl:rightOperand ?threshold ;
                odrl:operator ?operator .
    
    # Exclude Validity checks (handled by Validity.n3)
    ?operator log:notEqualTo odrl:isPartOf .

    # Exclude Consistency checks (handled by Consistency.n3)
    ?metric log:notEqualTo ab:CheckConsistency .
}
=>
{
    # Create quality measurement operation chained from LoadData (TERMINAL)
    # ROLE-ANNOTATED INPUTS: Each input has explicit role
    _:qualityOp a tb:Operation ;
                tb:hasAbstract ?metric ;              # Quality metric (e.g., dqv:completeness)
                tb:hasInput [
                    tb:value ?physicalAttr ;
                    tb:role "targetAttribute"
                ] ;
                tb:hasInput [
                    tb:value ab:data ;
                    tb:role "previousResult"
                ] ;
                tb:hasInput [
                    tb:value ?threshold ;
                    tb:role "threshold"
                ] ;
                tb:hasInput [
                    tb:value ?operator ;
                    tb:role "operator"
                ] ;
                tb:hasOutput ab:boolean ;
                tb:isTerminal true .
    
    # Chain from LoadData
    ?loadOp tb:nextStep _:qualityOp .
} .
