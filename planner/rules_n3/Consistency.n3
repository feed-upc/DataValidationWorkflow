# N3 Logic Rule: Consistency Policy Transformation (Refinement-Based)
# Rule Chaining - Automatically chains from LoadData operation
#
# Matches ODRL policies where the permission has a duty with:
#   - An action refined by a condition (odrl:refinement on the Action)
#   - A constraint specifying the expected value for the target attribute
#
# Example: "When gender isAnyOf male, pregnancyHistory must be NULL"
#   - Refinement: gender isAnyOf "male" (the WHERE/condition)
#   - Constraint: ConsistencyMeasurement eq "NULL" (the expected value)
#   - Target: pregnancyHistory (from permission's odrl:target)

@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix tb: <http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/tbox#> .
@prefix ab: <http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/abox#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix csvw: <http://www.w3.org/ns/csvw#> .
@prefix schema: <http://schema.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

{
    ?pc a tb:PolicyChecker ;
        tb:accordingTo ?policy ;
        tb:validates ?dataset ;
        tb:nextStep ?loadOp .
    
    ?loadOp a tb:Operation ;
            tb:hasAbstract ab:LoadData .
    
    ?policy a dqv:QualityPolicy ;
            odrl:permission ?permission .
    
    # Navigate to duty with action refinement
    ?permission odrl:duty ?duty .
    
    ?duty odrl:action ?actionNode .
    ?actionNode rdf:value ab:CheckConsistency .
    ?actionNode odrl:refinement ?refinement .
    
    # Extract condition from refinement
    ?refinement odrl:leftOperand ?condAttr .
    ?refinement odrl:rightOperand ?condValues .
    
    # Extract expected value from duty constraint
    ?duty odrl:constraint ?constraint .
    ?constraint odrl:rightOperand ?expectedValue .
    
    ?policy tb:qualityDimension "Consistency" .

    ?permission tb:physicalAttribute ?targetAttr .
    
}
=>
{
    _:consistencyOp a tb:Operation ;
                  tb:hasAbstract ab:CheckConsistency ;
                  tb:hasInput [
                      tb:value ?targetAttr ;
                      tb:role "targetAttribute"
                  ] ;
                  tb:hasInput [
                      tb:value ab:data ;
                      tb:role "previousResult"
                  ] ;
                  tb:hasInput [
                      tb:value ?condAttr ;
                      tb:role "conditionAttribute"
                  ] ;
                  tb:hasInput [
                      tb:value ?condValues ;
                      tb:role "conditionValues"
                  ] ;
                  tb:hasInput [
                      tb:value ?expectedValue ;
                      tb:role "expectedValue"
                  ] ;
                  tb:hasOutput ab:boolean ;
                  tb:isTerminal true .
    
    ?loadOp tb:nextStep _:consistencyOp .
} .
