# N3 Logic Rule: Consistency Policy Transformation
# Rule Chaining - Automatically chains from LoadData operation
#
# Transforms ODRL Permission policies with consistency constraints into data quality validation operations.

@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix tb: <http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/tbox#> .
@prefix ab: <http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/abox#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix qudt: <http://qudt.org/vocab/unit/> .
@prefix csvw: <http://www.w3.org/ns/csvw#> .
@prefix schema: <http://schema.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

{
    ?pc a tb:PolicyChecker ;
        tb:accordingTo ?policy ;
        tb:validates ?dataset ;
        tb:nextStep ?loadOp .
    
    ?loadOp a tb:Operation ;
            tb:hasAbstract ab:LoadData .
    
    ?policy a dqv:QualityPolicy ;
            odrl:permission ?permission .
    
    ?permission odrl:constraint ?constraint .

    ?constraint odrl:leftOperand ?metric ;
                odrl:operator ?operator ;
                odrl:rightOperand ?threshold .
    
    ?policy tb:qualityDimension "Consistency" .

    ?permission tb:physicalAttribute ?targetAttr .
    
}
=>
{
    _:consistencyOp a tb:Operation ;
                  tb:hasAbstract ab:CheckConsistency ;
                  tb:hasInput [
                      tb:value ?targetAttr ;
                      tb:role "targetAttribute"
                  ] ;
                  tb:hasInput [
                      tb:value ab:data ;
                      tb:role "previousResult"
                  ] ;
                  tb:hasOutput ab:score ;
                  tb:nextStep _:validationOp .
    
    ?loadOp tb:nextStep _:consistencyOp .
    
    _:validationOp a tb:Operation ;
                   tb:hasAbstract odrl:Constraint ;
                   tb:hasInput [
                       tb:value ab:data ;
                       tb:role "previousResult"
                   ] ;
                   tb:hasInput [
                       tb:value ?threshold ;
                       tb:role "threshold"
                   ] ;
                   tb:hasInput [
                       tb:value ?operator ;
                       tb:role "operator"
                   ] ;
                   tb:hasOutput ab:boolean ;
                   tb:isTerminal true .
    
    _:consistencyOp tb:nextStep _:validationOp .
} .
