# N3 Logic Rule: Validity Policy Transformation (SEMANTIC VERSION)
# Rule Chaining - Automatically chains from LoadData operation
#
# Transforms ODRL Permission policies with validity constraints into data quality validation operations.
# USES SEMANTIC PROPERTIES instead of flat hasInput for unambiguous parameter binding.

@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix tb: <http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/tbox#> .
@prefix ab: <http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/abox#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix qudt: <http://qudt.org/vocab/unit/> .
@prefix csvw: <http://www.w3.org/ns/csvw#> .
@prefix schema: <http://schema.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

# Rule: Quality Policy with Permission and Validity Constraint → CheckValidity + Validation Operations
# Chains from LoadData when Quality policy with permission and validity constraint exists
# Creates TWO operations with SEMANTIC properties
{
    # Match PolicyChecker with Quality policy
    ?pc a tb:PolicyChecker ;
        tb:accordingTo ?policy ;
        tb:validates ?dataset ;
        tb:nextStep ?loadOp .
    
    # LoadData operation
    ?loadOp a tb:Operation ;
            tb:hasAbstract ab:LoadData .
    
    # Check Validity Policy
    ?policy a dqv:QualityPolicy ;
            odrl:permission ?permission .
    
    ?permission odrl:constraint ?constraint .

    # Constraint details (Validity >= threshold)
    ?constraint odrl:leftOperand ?metric ;
                odrl:operator ?operator ;
                odrl:rightOperand ?threshold .
    
    # Ensure it is Validity
    ?policy tb:qualityDimension "Validity" .

    # Resolve physical attribute via ConstraintPropagation rule
    ?permission tb:physicalAttribute ?targetAttr .
    
}
=>
{
    # Operation 1: Quality Metric Calculation (Validity)
    # ROLE-ANNOTATED INPUTS: Each input has explicit role
    _:validityOp a tb:Operation ;
                  tb:hasAbstract ab:qM_Validity ;
                  tb:hasInput [
                      tb:value ?targetAttr ;
                      tb:role "targetAttribute"
                  ] ;
                  tb:hasInput [
                      tb:value ab:data ;
                      tb:role "previousResult"
                  ] ;
                  tb:hasOutput ab:score ;  # Outputs a percentage/score
                  tb:nextStep _:validationOp .
    
    # Chain Operation 1 from LoadData
    ?loadOp tb:nextStep _:validityOp .
    
    # Operation 2: Constraint validation - check score against threshold (TERMINAL)
    # ROLE-ANNOTATED INPUTS: Multiple inputs with different roles
    _:validationOp a tb:Operation ;
                   tb:hasAbstract odrl:Constraint ;
                   tb:hasInput [
                       tb:value ab:data ;
                       tb:role "previousResult"
                   ] ;
                   tb:hasInput [
                       tb:value ?threshold ;
                       tb:role "threshold"
                   ] ;
                   tb:hasInput [
                       tb:value ?operator ;
                       tb:role "operator"
                   ] ;
                   tb:hasOutput ab:boolean ;
                   tb:isTerminal true .
    
    # Chain Operation 2 from Operation 1
    _:validityOp tb:nextStep _:validationOp .
} .
