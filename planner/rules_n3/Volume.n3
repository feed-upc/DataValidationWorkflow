# N3 Logic Rule: Volume Policy Transformation (SEMANTIC VERSION)
# Rule Chaining - Automatically chains from LoadData operation
#
# Transforms ODRL Permission policies with Volume constraints into data quality validation operations.
# Matches on the measurement action (CheckVolume) rather than dimension string,
# so this works for rules classified under any dimension (e.g. Validity).

@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix tb: <http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/tbox#> .
@prefix ab: <http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/abox#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .

{
    # Match PolicyChecker with Quality policy
    ?pc a tb:PolicyChecker ;
        tb:accordingTo ?policy ;
        tb:validates ?dataset ;
        tb:nextStep ?loadOp .
    
    # LoadData operation
    ?loadOp a tb:Operation ;
            tb:hasAbstract ab:LoadData .
    
    # Check Volume Policy
    ?policy a dqv:QualityPolicy ;
            odrl:permission ?permission .
    
    ?permission odrl:constraint ?constraint .

    # Constraint details (Row count >= threshold)
    ?constraint odrl:leftOperand ?metric ;
                odrl:operator ?operator ;
                odrl:rightOperand ?threshold .
    
    # Match on the measurement action: metric must measure CheckVolume
    ?metric dqv:isMeasurementOf ab:CheckVolume .
}
=>
{
    # Operation 1: Quality Metric Calculation (Row Count)
    _:volumeOp a tb:Operation ;
               tb:hasAbstract ab:CheckVolume ;
               tb:hasInput [
                   tb:value ab:data ;
                   tb:role "previousResult"
               ] ;
               tb:hasOutput ab:score ;
               tb:nextStep _:validationOp .
    
    # Chain Operation 1 from LoadData
    ?loadOp tb:nextStep _:volumeOp .
    
    # Operation 2: Constraint validation - check score against threshold (TERMINAL)
    _:validationOp a tb:Operation ;
                   tb:hasAbstract odrl:Constraint ;
                   tb:hasInput [
                       tb:value ab:data ;
                       tb:role "previousResult"
                   ] ;
                   tb:hasInput [
                       tb:value ?threshold ;
                       tb:role "threshold"
                   ] ;
                   tb:hasInput [
                       tb:value ?operator ;
                       tb:role "operator"
                   ] ;
                   tb:hasOutput ab:boolean ;
                   tb:isTerminal true .
    
    # Chain Operation 2 from Operation 1
    _:volumeOp tb:nextStep _:validationOp .
} .
