# DQVP Rule: RowComparisonRate → CheckConsistency
# Resolves B1 + B3: targetAttribute, conditionAttribute, and conditionValues are
# all named properties — the context column and evaluated column are unambiguously linked.
#
# Input (after plan_dqvp() flattening):
#   ?constraint odrl:leftOperand dqvp:RowComparisonRate ;
#               dqvp:targetAttribute    ?targetAttr ;
#               dqvp:conditionAttribute ?condAttr ;
#               dqvp:conditionValues    ?condValues ;
#               odrl:operator           ?operator ;
#               odrl:rightOperand       ?expectedValue .

@prefix odrl:  <http://www.w3.org/ns/odrl/2/> .
@prefix dqvp:  <https://w3id.org/odrl/profile/dataquality#> .
@prefix tb:    <http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/tbox#> .
@prefix ab:    <http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/abox#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

{
    ?pc a tb:PolicyChecker ;
        tb:accordingTo ?policy ;
        tb:nextStep ?loadOp .

    ?loadOp a tb:Operation ;
            tb:hasAbstract ab:LoadData .

    ?policy a dqvp:QualityPolicy ;
            odrl:permission ?permission .

    ?permission odrl:constraint ?constraint .

    ?constraint odrl:leftOperand     dqvp:RowComparisonRate ;
                dqvp:targetAttribute    ?targetAttr ;
                dqvp:conditionAttribute ?condAttr ;
                dqvp:conditionValues    ?condValues ;
                odrl:operator           ?operator ;
                odrl:rightOperand       ?expectedValue .
}
=>
{
    _:checkOp a tb:Operation ;
              tb:hasAbstract ab:CheckConsistency ;
              tb:hasInput [ tb:value ?targetAttr ;    tb:role "targetAttribute"    ] ;
              tb:hasInput [ tb:value ?condAttr ;      tb:role "conditionAttribute" ] ;
              tb:hasInput [ tb:value ?condValues ;    tb:role "conditionValues"    ] ;
              tb:hasInput [ tb:value ?expectedValue ; tb:role "expectedValue"      ] ;
              tb:hasInput [ tb:value ab:data ;        tb:role "previousResult"     ] ;
              tb:hasOutput ab:boolean ;
              tb:isTerminal true .

    ?loadOp tb:nextStep _:checkOp .
} .
