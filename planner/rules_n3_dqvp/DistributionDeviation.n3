# DQVP Rule: DistributionDeviation → CheckFairness
# Measures max category frequency deviation from uniform distribution.
#
# Input (after plan_dqvp() flattening):
#   ?constraint odrl:leftOperand dqvp:DistributionDeviation ;
#               dqvp:targetAttribute ?targetAttr ;
#               odrl:operator        ?operator ;
#               odrl:rightOperand    ?threshold .

@prefix odrl:  <http://www.w3.org/ns/odrl/2/> .
@prefix dqvp:  <https://w3id.org/odrl/profile/dataquality#> .
@prefix tb:    <http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/tbox#> .
@prefix ab:    <http://www.semanticweb.org/acraf/ontologies/2024/healthmesh/abox#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

{
    ?pc a tb:PolicyChecker ;
        tb:accordingTo ?policy ;
        tb:nextStep ?loadOp .

    ?loadOp a tb:Operation ;
            tb:hasAbstract ab:LoadData .

    ?policy a dqvp:QualityPolicy ;
            odrl:permission ?permission .

    ?permission odrl:constraint ?constraint .

    ?constraint odrl:leftOperand dqvp:DistributionDeviation ;
                dqvp:targetAttribute ?targetAttr ;
                odrl:operator        ?operator ;
                odrl:rightOperand    ?threshold .
}
=>
{
    _:fairnessOp a tb:Operation ;
                 tb:hasAbstract ab:CheckFairness ;
                 tb:hasInput [ tb:value ?targetAttr ; tb:role "targetAttribute" ] ;
                 tb:hasInput [ tb:value ab:data ;     tb:role "previousResult"  ] ;
                 tb:hasOutput ab:score ;
                 tb:nextStep _:validOp .

    ?loadOp tb:nextStep _:fairnessOp .

    _:validOp a tb:Operation ;
              tb:hasAbstract odrl:Constraint ;
              tb:hasInput [ tb:value ab:data ;    tb:role "previousResult" ] ;
              tb:hasInput [ tb:value ?threshold ; tb:role "threshold"      ] ;
              tb:hasInput [ tb:value ?operator ;  tb:role "operator"       ] ;
              tb:hasOutput ab:boolean ;
              tb:isTerminal true .

    _:fairnessOp tb:nextStep _:validOp .
} .
